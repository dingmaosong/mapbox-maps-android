"id\":9,\"attributes\":{\"slug\":\"dalibor-janak\",\"name\":\"Dalibor Janak\",\"job\":\"Senior Product Manager \u0026 Tech Lead\",\"createdAt\":\"2023-09-22T09:54:11.769Z\",\"updatedAt\":\"2023-09-22T11:17:26.340Z\",\"publishedAt\":\"2023-09-22T09:54:17.769Z\",\"description\":\"Dalibor is a full-stack developer but is most active on the front-end. His responsibility is UX / UI design, and he likes coding with SASS. His experience also includes JavaScript, PHP, and Python. Dalibor has a master’s degree in GIS and takes care of cartography and geo health in the team.\\n\\nHis passion is mountains, speleology, and climbing.\",\"locale\":\"en\"}}},\"tagsRel\":{\"data\":[{\"id\":4,\"attributes\":{\"name\":\"cloud\",\"slug\":\"cloud\",\"createdAt\":\"2025-10-16T07:35:33.113Z\",\"updatedAt\":\"2025-12-17T13:02:40.219Z\"}},{\"id\":5,\"attributes\":{\"name\":\"customize\",\"slug\":\"customize\",\"createdAt\":\"2025-10-16T07:35:33.224Z\",\"updatedAt\":\"2025-12-17T13:02:40.176Z\"}},{\"id\":6,\"attributes\":{\"name\":\"cartography\",\"slug\":\"cartography\",\"createdAt\":\"2025-10-16T07:35:33.255Z\",\"updatedAt\":\"2025-12-17T13:02:30.534Z\"}}]},\"localizations\":{\"data\":[]}}},{\"id\":240,\"attributes\":{\"shortName\":\"Import GIS data to webmaps\",\"slug\":\"2024/09/import-gis-data-to-webmaps\",\"type\":\"article\",\"tags\":\"cloud,data,engine\",\"date\":\"2024-09-19\",\"description\":\"Improved import of GIS data into webmaps now available in MapTiler Cloud\",\"createdAt\":\"2024-09-18T13:12:14.149Z\",\"updatedAt\":\"2024-09-19T15:51:34.906Z\",\"publishedAt\":\"2024-09-19T15:51:34.895Z\",\"content\":\"$23\",\"locale\":\"en\",\"thumbnail\":{\"data\":{\"id\":2064,\"attributes\":{\"name\":\"2024-09-import-gis-data-1.webp\",\"alternativeText\":\"Import GIS data to MapTiler Cloud\",\"caption\":null,\"width\":1600,\"height\":900,\"formats\":{\"large\":{\"ext\":\".webp\",\"url\":\"https://media.maptiler.com/img/large_2024_09_import_gis_data_1_3b94f2cd22.webp\",\"hash\":\"large_20