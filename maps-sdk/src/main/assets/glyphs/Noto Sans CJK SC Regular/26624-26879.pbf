_airbus_satellite_maps_in_maptiler_maps_api_1_d6ed20e60a\",\"mime\":\"image/jpeg\",\"name\":\"medium_2019-10-01-airbus-satellite-maps-in-maptiler-maps-api-1.jpg\",\"path\":null,\"size\":105.68,\"width\":750,\"height\":422},\"thumbnail\":{\"ext\":\".jpg\",\"url\":\"https://media.maptiler.com/img/thumbnail_2019_10_01_airbus_satellite_maps_in_maptiler_maps_api_1_d6ed20e60a.jpg\",\"hash\":\"thumbnail_2019_10_01_airbus_satellite_maps_in_maptiler_maps_api_1_d6ed20e60a\",\"mime\":\"image/jpeg\",\"name\":\"thumbnail_2019-10-01-airbus-satellite-maps-in-maptiler-maps-api-1.jpg\",\"path\":null,\"size\":11.72,\"width\":245,\"height\":138}},\"hash\":\"2019_10_01_airbus_satellite_maps_in_maptiler_maps_api_1_d6ed20e60a\",\"ext\":\".jpg\",\"mime\":\"image/jpeg\",\"size\":455.33,\"url\":\"https://media.maptiler.com/img/2019_10_01_airbus_satellite_maps_in_maptiler_maps_api_1_d6ed20e60a.jpg\",\"previewUrl\":null,\"provider\":\"aws-s3\",\"provider_metadata\":null,\"createdAt\":\"2023-10-04T15:28:39.091Z\",\"updatedAt\":\"2024-01-15T16:57:01.313Z\"}}},\"newsContent\":[],\"author\":{\"data\":{\"id\":9,\"attributes\":{\"slug\":\"dalibor-janak\",\"name\":\"Dalibor Janak\",\"job\":\"Senior Product Manager \u0026 Tech Lead\",\"createdAt\":\"2023-09-22T09:54:11.769Z\",\"updatedAt\":\"2023-09-22T11:17:26.340Z\",\"publishedAt\":\"2023-09-22T09:54:17.769Z\",\"description\":\"Dalibor is a full-stack developer but is most active on the front-end. His responsibility is UX / UI design, and he likes coding with SASS. His experience also includes JavaScript, PHP, and Python. Dalibor has a master’s degree in GIS and takes care of cartography and geo health in the team.\\n\\nHis passion is mountains, speleology, and climbing.\",\"locale\":\"en\"}}},\"tagsRel\":{\"data\":[{\"id\":23,\"attributes\":{\"name\":\"maps\",\"slug\":\"maps\",\"createdAt\":\"2025-10-16T07:35:35.032Z\",\"updatedAt\":\"2025-12-17T13:02:40.162Z\"}},{\"id\":4,\"attributes\":{\"name\":\"cloud\",\"slug\":\"cloud\",\"createdAt\":\"2025-10-16T07:35:33.113Z\",\"updatedAt\":\"2025-12-17T13:02:40.219Z\"}}]},\"localizations\":{\"data\":[]}}},{\"id\":88,\"attributes\":{\"shortName\":\"MapTiler Desktop 10.2\",\"slug\":\"2019/10/maptiler-desktop-10-2\",\"type\":\"article\",\"tags\":\"desktop,cloud\",\"date\":\"2019-10-15\",\"description\":\"MapTiler Desktop 10.2 is able to generate map in any geographic coordinate system in GeoPackage format and directly upload to MapTiler Cloud.\",\"createdAt\":\"2023-10-04T15:25:44.328Z\",\"updatedAt\":\"2023-10-23T09:30:25.055Z\",\"publishedAt\":\"2023-10-04T15:25:45.396Z\",\"content\":\"$41\",\"locale\":\"en\",\"thumbnail\":{\"data\":{\"id\":666,\"attributes\":{\"name\":\"2019-10-15-maptiler-desktop-10-2-1.png\",\"alternativeText\":\"MapTiler Engine 10.2\",\"caption\":null,\"width\":1600,\"height\":900,\"formats\":{\"large\":{\"ext\":\".png\",\"url\":\"https://media.maptiler.com/img/large_2019_10_15_maptiler_desktop_10_2_1_8ecc91c52b.png\",\"hash\":\"large_2019_10_15_maptiler_desktop_10_2_1_8ecc91c52b\",\"mime\":\"image/png\",\"name\":\"large_2019-10-15-maptiler-desktop-10-2-1.png\",\"path\":null,\"size\":338.03,\"width\":1000,\"height\":563},\"small\":{\"ext\":\".png\",\"url\":\"https://media.maptiler.com/img/small_2019_10_15_maptiler_desktop_10_2_1_8ecc91c52b.png\",\"hash\":\"small_2019_10_15_maptiler_desktop_10_2_1_8ecc91c52b\",\"mime\":\"image/png\",\"name\":\"small_2019-10-15-maptiler-desktop-10-2-1.png\",\"path\":null,\"size\":70.75,\"width\":500,\"height\":281},\"medium\":{\"ext\":\".png\",\"url\":\"https://media.maptiler.com/img/medium_2019_10_15_maptiler_desktop_10_2_1_8ecc91c52b.png\",\"hash\":\"medium_2019_10_15_maptiler_desktop_10_2_1_8ecc91c52b\",\"mime\":\"image/png\",\"name\":\"medium_2019-10-15-maptiler-desktop-10-2-1.png\",\"path\":null,\"size\":170.47,\"width\":750,\"height\":422},\"thumbnail\":{\"ext\":\".png\",\"url\":\"https://media.maptiler.com/img/thumbnail_2019_10_15_maptiler_desktop_10_2_1_8ecc91c52b.png\",\"hash\":\"thumbnail_2019_10_15_mapti