:\".png\",\"url\":\"https://media.maptiler.com/img/thumbnail_2021_09_23_vector_basemaps_in_qgis_1_a432f113fc.png\",\"hash\":\"thumbnail_2021_09_23_vector_basemaps_in_qgis_1_a432f113fc\",\"mime\":\"image/png\",\"name\":\"thumbnail_2021-09-23-vector-basemaps-in-qgis-1.png\",\"path\":null,\"size\":86.07,\"width\":245,\"height\":138}},\"hash\":\"2021_09_23_vector_basemaps_in_qgis_1_a432f113fc\",\"ext\":\".png\",\"mime\":\"image/png\",\"size\":722.55,\"url\":\"https://media.maptiler.com/img/2021_09_23_vector_basemaps_in_qgis_1_a432f113fc.png\",\"previewUrl\":null,\"provider\":\"aws-s3\",\"provider_metadata\":null,\"createdAt\":\"2023-10-03T14:26:51.547Z\",\"updatedAt\":\"2024-01-15T20:59:21.052Z\"}}},\"newsContent\":[],\"author\":{\"data\":{\"id\":19,\"attributes\":{\"slug\":\"adam-laza\",\"name\":\"Adam Laza\",\"job\":\"Geodata Specialist\",\"createdAt\":\"2023-09-22T11:49:05.458Z\",\"updatedAt\":\"2023-10-02T09:01:53.398Z\",\"publishedAt\":\"2023-09-22T11:49:06.526Z\",\"description\":\"Adam is a proud member of the Data team. He graduated with excellence in Geoinformatics. During his studies, he participated in Google Summer of Code. Since then, he’s been an enthusiast for open-source and has contributed to several projects. He is always keen on learning new technologies, but he believes there is no problem you couldn’t fix with Python, PostGIS, and enough duct tape.\\n\\nHe loves night rides on his fixed-gear bike and plays Ultimate Frisbee. If there isn’t any tournament on the weekend, you will probably find him hiking in the mountains.\",\"locale\":\"en\"}}},\"tagsRel\":{\"data\":[{\"id\":46,\"attributes\":{\"name\":\"qgis\",\"slug\":\"qgis\",\"createdAt\":\"2025-10-16T07:35:38.583Z\",\"updatedAt\":\"2025-12-17T13:02:39.600Z\"}},{\"id\":16,\"attributes\":{\"name\":\"open-source\",\"slug\":\"open-source\",\"createdAt\":\"2025-10-16T07:35:34.426Z\",\"updatedAt\":\"2025-12-17T13:02:40.133Z\"}},{\"id\":32,\"attributes\":{\"name\":\"osgeo\",\"slug\":\"osgeo\",\"createdAt\":\"2025-10-16T07:35:35.703Z\",\"updatedAt\":\"2025-12-17T13:02:38.486Z\"}},{\"id\":4,\"attributes\":{\"name\":\"cloud\",\"slug\":\"cloud\",\"createdAt\":\"2025-10-16T07:35:33.113Z\",\"updatedAt\":\"2025-12-17T13:02:40.219Z\"}},{\"id\":43,\"attributes\":{\"name\":\"vector tiles\",\"slug\":\"vector-tiles\",\"createdAt\":\"2025-10-16T07:35:37.332Z\",\"updatedAt\":\"2025-12-17T13:02:39.921Z\"}}]},\"localizations\":{\"data\":[]}}},{\"id\":42,\"attributes\":{\"shortName\":\"Detailed maps with quality control\",\"slug\":\"2021/12/detailed-maps-with-quality-control\",\"type\":\"article\",\"tags\":\"cloud,data,maps\",\"date\":\"2021-12-16\",\"description\":\"New MapTiler Planet maps have more than 150 million new buildings, quality control, greatly improved landcover, and upgraded hillshading and contours. It’s our best ever mapping!\",\"createdAt\":\"2023-10-03T14:22:20.681Z\",\"updatedAt\":\"2025-02-12T16:07:02.344Z\",\"publishedAt\":\"2023-10-03T14:23:22.469Z\",\"content\":\"$58\",\"locale\":\"en\",\"thumbnail\":{\"data\":{\"id\":477,\"attributes\":{\"name\":\"2021-12-17-detailed-maps-with-quality-control-1.png\",\"alternativeText\":\"Map with quality control\",\"caption\":null,\"width\":1140,\"height\":642,\"formats\":{\"large\":{\"ext\":\".png\",\"url\":\"https://media.maptiler.com/img/large_2021_12_17_detailed_maps_with_quality_control_1_32c0dd37ff.png\",\"hash\":\"large_2021_12_17_detailed_maps_with_quality_control_1_32c0dd37ff\",\"mime\":\"image/png\",\"name\":\"large_2021-12-17-detailed-maps-with-quality-control-1.png\",\"path\":null,\"size\":931.37,\"width\":1000,\"height\":563},\"small\":{\"ext\":\".png\",\"url\":\"https://media.maptiler.com/img/small_2021_12_17_detailed_maps_with_quality_control_1_32c0dd37ff.png\",\"hash\":\"small_2021_12_17_detailed_maps_with_quality_control_1_32c0dd37ff\",\"mime\":\"image/png\",\"name\":\"small_2021-12-17-detailed-maps-with-quality-control-1.png\",\"path\":null,\"size\":263.51,\"width\":500,\"height\":282},\"medium\":{\"ext\":\".png\",\"url\":\"https://media.maptiler.com/img/medium_2021_12_17_detailed_maps_with_quality_control_1_32c0dd37ff.png\",\"hash\":\"medium_2021_12_17_detailed_maps_with_quality_control_1_32c0dd37ff\",\"mime\":\"image/png\",\"name\":\"medium_2021-12-17-detailed-maps-with-quality-control-1.png\",\"path\":null,\"size\":545.76,\"width\":750,\"height\":422},\"thumbnail\":{\"ext\":\".png\",\"url\":\"https://media.maptiler.com/img/thumbnail_2021_12_17_detailed_maps_with_quality_control_1_32c0dd37ff.png\",\"hash\":\"thumbnail_2021_12_17_detailed_maps_with_quality_control_1_32c0dd37ff\",\"mime\":\"image/png\",\"name\":\"thumbnail_2021-12-17-detailed-maps-with-quality-control-1.png\",\"path\":null,\"size\":74.75,\"width\":245,\"height\":138}},\"hash\":\"2021_12_17_detailed_maps_with_quality_control_1_32c0dd37ff\",\"ext\":\".png\",\"mime\":\"image/png\",\"size\":226.94,\"url\":\"https://media.maptiler.com/img/2021_12_17_detailed_maps_with_quality_control_1_32c0dd37ff.png\",\"previewUrl\":null,\"provider\":\"aws-s3\",\"provider_metadata\":null,\"createdAt\":\"2023-10-03T14:16:55.530Z\",\"updatedAt\":\"2024-01-15T21:01:04.260Z\"}}},\"newsContent\":[],\"author\":{\"data\":{\"id\":9,\"attributes\":{\"slug\":\"dalibor-janak\",\"name\":\"Dalibor Janak\",\"job\":\"Senior Product Manager \u0026 Tech Lead\",\"createdAt\":\"2023-09-22T09:54:11.769Z\",\"updatedAt\":\"2023-09-22T11:17:26.340Z\",\"publishedAt\":\"2023-09-22T09:54:17.769Z\",\"description\":\"Dalibor is a full-stack developer but is most active on the front-end. His responsibility is UX / UI design, and he likes coding with SASS. His experience also includes JavaScript, PHP, and Python. Dalibor has a master’s degree in GIS and takes care of cartography and geo health in the team.\\n\\nHis passion is mountains, speleology, and climbing.\",\"locale\":\"en\"}}},\"tagsRel\":{\"data\":[{\"id\":4,\"attributes\":{\"name\":\"cloud\",\"slug\":\"cloud\",\"createdAt\":\"2025-10-16T07:35:33.113Z\",\"updatedAt\":\"2025-12-17T13:02:40.2