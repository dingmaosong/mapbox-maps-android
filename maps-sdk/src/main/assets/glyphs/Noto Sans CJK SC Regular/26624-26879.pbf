f2e07\",\"mime\":\"image/png\",\"name\":\"thumbnail_2019-12-10-maptiler-desktop-10-3-1.png\",\"path\":null,\"size\":22.07,\"width\":245,\"height\":138}},\"hash\":\"2019_12_10_maptiler_desktop_10_3_1_3cd7bf2e07\",\"ext\":\".png\",\"mime\":\"image/png\",\"size\":607.79,\"url\":\"https://media.maptiler.com/img/2019_12_10_maptiler_desktop_10_3_1_3cd7bf2e07.png\",\"previewUrl\":null,\"provider\":\"aws-s3\",\"provider_metadata\":null,\"createdAt\":\"2023-10-04T14:31:18.430Z\",\"updatedAt\":\"2024-01-15T17:03:42.612Z\"}}},\"newsContent\":[],\"author\":{\"data\":{\"id\":8,\"attributes\":{\"slug\":\"martin-mikita\",\"name\":\"Martin Mikita\",\"job\":\"Senior Tech Lead \u0026 Developers Chief\",\"createdAt\":\"2023-09-22T09:50:08.578Z\",\"updatedAt\":\"2023-09-22T11:16:47.589Z\",\"publishedAt\":\"2023-09-22T09:50:09.922Z\",\"description\":\"MIKI (as his friends call him) is a developer of desktop applications, and his daily routine is to connect software functionality with a graphical user interface. After debugging, the most lovely job of every IT, he relaxes playing desk games with his friends or watching movies. In his spare evenings, MIKI plays floorball or drinks beer. He holds a master’s degree in informatics.\",\"locale\":\"en\"}}},\"tagsRel\":{\"data\":[{\"id\":20,\"attributes\":{\"name\":\"Desktop\",\"slug\":\"desktop\",\"createdAt\":\"2025-10-16T07:35:34.665Z\",\"updatedAt\":\"2025-12-17T13:02:40.188Z\"}},{\"id\":4,\"attributes\":{\"name\":\"cloud\",\"slug\":\"cloud\",\"createdAt\":\"2025-10-16T07:35:33.113Z\",\"updatedAt\":\"2025-12-17T13:02:40.219Z\"}}]},\"localizations\":{\"data\":[]}}},{\"id\":79,\"attributes\":{\"shortName\":\"Your data on a map without coding\",\"slug\":\"2019/12/your-data-on-a-map-without-coding\",\"type\":\"article\",\"tags\":\"cloud,vector data editor\",\"date\":\"2019-12-17\",\"description\":\"Add position of your shop in the city, hiking trails with related points of interest, electric power grid or any other vector data on a map with a f