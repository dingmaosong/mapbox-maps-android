jpg\",\"previewUrl\":null,\"provider\":\"aws-s3\",\"provider_metadata\":null,\"createdAt\":\"2023-10-04T14:19:59.434Z\",\"updatedAt\":\"2024-01-15T20:12:44.432Z\"}}},\"newsContent\":[],\"author\":{\"data\":{\"id\":11,\"attributes\":{\"slug\":\"martin-elias\",\"name\":\"Martin Elias\",\"job\":\"CXO\",\"createdAt\":\"2023-09-22T11:20:27.405Z\",\"updatedAt\":\"2023-09-22T11:20:29.328Z\",\"publishedAt\":\"2023-09-22T11:20:29.322Z\",\"description\":\"As Chief Experience Officer, Martin manages the MapTiler’s entire customer experience strategy, including customer journey mapping, overseeing customer success and customer service teams. He is also responsible for improving employee experience and engagement.\\n\\nIn his personal life, Martin loves cooking, especially Italian cuisine, and is a coffee enthusiast. He also loves singing and is a passionate floorball player.\",\"locale\":\"en\"}}},\"tagsRel\":{\"data\":[{\"id\":4,\"attributes\":{\"name\":\"cloud\",\"slug\":\"cloud\",\"createdAt\":\"2025-10-16T07:35:33.113Z\",\"updatedAt\":\"2025-12-17T13:02:40.219Z\"}},{\"id\":23,\"attributes\":{\"name\":\"maps\",\"slug\":\"maps\",\"createdAt\":\"2025-10-16T07:35:35.032Z\",\"updatedAt\":\"2025-12-17T13:02:40.162Z\"}},{\"id\":49,\"attributes\":{\"name\":\"japan\",\"slug\":\"japan\",\"createdAt\":\"2025-10-16T07:35:41.693Z\",\"updatedAt\":\"2025-12-17T13:02:39.063Z\"}}]},\"localizations\":{\"data\":[]}}},{\"id\":74,\"attributes\":{\"shortName\":\"Fighting coronavirus with MapTiler maps\",\"slug\":\"2020/03/fighting-coronavirus-with-maptiler-maps\",\"type\":\"article\",\"tags\":\"cloud,maps,customers,press\",\"date\":\"2020-03-10\",\"description\":\"How we supported journalism serving in the public good with our maps.\",\"createdAt\":\"2023-10-04T14:08:11.402Z\",\"updatedAt\":\"2024-03-27T11:44:26.587Z\",\"publishedAt\":\"2023-10-04T14:08:12.518Z\",\"content\":\"$4c\",\"locale\":\"en\",\"thumbnail\":{\"data\":{\"id\":620,\"attributes\":{\"name\":\"2020-03-10-fighting-coronavirus-w