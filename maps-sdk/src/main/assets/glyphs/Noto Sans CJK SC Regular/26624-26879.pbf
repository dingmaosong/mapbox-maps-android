aws-s3\",\"provider_metadata\":null,\"createdAt\":\"2023-10-04T15:09:23.012Z\",\"updatedAt\":\"2024-01-15T17:00:06.922Z\"}}},\"newsContent\":[],\"author\":{\"data\":{\"id\":9,\"attributes\":{\"slug\":\"dalibor-janak\",\"name\":\"Dalibor Janak\",\"job\":\"Senior Product Manager \u0026 Tech Lead\",\"createdAt\":\"2023-09-22T09:54:11.769Z\",\"updatedAt\":\"2023-09-22T11:17:26.340Z\",\"publishedAt\":\"2023-09-22T09:54:17.769Z\",\"description\":\"Dalibor is a full-stack developer but is most active on the front-end. His responsibility is UX / UI design, and he likes coding with SASS. His experience also includes JavaScript, PHP, and Python. Dalibor has a master’s degree in GIS and takes care of cartography and geo health in the team.\\n\\nHis passion is mountains, speleology, and climbing.\",\"locale\":\"en\"}}},\"tagsRel\":{\"data\":[{\"id\":4,\"attributes\":{\"name\":\"cloud\",\"slug\":\"cloud\",\"createdAt\":\"2025-10-16T07:35:33.113Z\",\"updatedAt\":\"2025-12-17T13:02:40.219Z\"}},{\"id\":34,\"attributes\":{\"name\":\"openstreetmap\",\"slug\":\"openstreetmap\",\"createdAt\":\"2025-10-16T07:35:35.734Z\",\"updatedAt\":\"2025-12-17T13:02:40.014Z\"}},{\"id\":23,\"attributes\":{\"name\":\"maps\",\"slug\":\"maps\",\"createdAt\":\"2025-10-16T07:35:35.032Z\",\"updatedAt\":\"2025-12-17T13:02:40.162Z\"}},{\"id\":36,\"attributes\":{\"name\":\"openlayers\",\"slug\":\"openlayers\",\"createdAt\":\"2025-10-16T07:35:36.197Z\",\"updatedAt\":\"2025-12-17T13:02:36.389Z\"}},{\"id\":43,\"attributes\":{\"name\":\"vector tiles\",\"slug\":\"vector-tiles\",\"createdAt\":\"2025-10-16T07:35:37.332Z\",\"updatedAt\":\"2025-12-17T13:02:39.921Z\"}},{\"id\":32,\"attributes\":{\"name\":\"osgeo\",\"slug\":\"osgeo\",\"createdAt\":\"2025-10-16T07:35:35.703Z\",\"updatedAt\":\"2025-12-17T13:02:38.486Z\"}}]},\"localizations\":{\"data\":[]}}},{\"id\":85,\"attributes\":{\"shortName\":\"Manage Your Costs with MapTiler Cloud\",\"slug\":\"2019/11/manage-your-costs-with-maptiler-cloud\",\"type\":\"article\",\"ta