five-clicks-1.png\",\"path\":null,\"size\":311.86,\"width\":500,\"height\":281},\"medium\":{\"ext\":\".png\",\"url\":\"https://media.maptiler.com/img/medium_2018_09_04_design_own_map_with_five_clicks_1_c1cbe000c1.png\",\"hash\":\"medium_2018_09_04_design_own_map_with_five_clicks_1_c1cbe000c1\",\"mime\":\"image/png\",\"name\":\"medium_2018-09-04-design-own-map-with-five-clicks-1.png\",\"path\":null,\"size\":657.37,\"width\":750,\"height\":422},\"thumbnail\":{\"ext\":\".png\",\"url\":\"https://media.maptiler.com/img/thumbnail_2018_09_04_design_own_map_with_five_clicks_1_c1cbe000c1.png\",\"hash\":\"thumbnail_2018_09_04_design_own_map_with_five_clicks_1_c1cbe000c1\",\"mime\":\"image/png\",\"name\":\"thumbnail_2018-09-04-design-own-map-with-five-clicks-1.png\",\"path\":null,\"size\":84.16,\"width\":245,\"height\":138}},\"hash\":\"2018_09_04_design_own_map_with_five_clicks_1_c1cbe000c1\",\"ext\":\".png\",\"mime\":\"image/png\",\"size\":721.72,\"url\":\"https://media.maptiler.com/img/2018_09_04_design_own_map_with_five_clicks_1_c1cbe000c1.png\",\"previewUrl\":null,\"provider\":\"aws-s3\",\"provider_metadata\":null,\"createdAt\":\"2023-10-05T14:18:03.004Z\",\"updatedAt\":\"2024-01-15T16:15:28.634Z\"}}},\"newsContent\":[],\"author\":{\"data\":{\"id\":9,\"attributes\":{\"slug\":\"dalibor-janak\",\"name\":\"Dalibor Janak\",\"job\":\"Senior Product Manager \u0026 Tech Lead\",\"createdAt\":\"2023-09-22T09:54:11.769Z\",\"updatedAt\":\"2023-09-22T11:17:26.340Z\",\"publishedAt\":\"2023-09-22T09:54:17.769Z\",\"description\":\"Dalibor is a full-stack developer but is most active on the front-end. His responsibility is UX / UI design, and he likes coding with SASS. His experience also includes JavaScript, PHP, and Python. Dalibor has a master’s degree in GIS and takes care of cartography and geo health in the team.\\n\\nHis passion is mountains, speleology, and climbing.\",\"locale\":\"en\"}}},\"tagsRel\":{\"data\":[{\"id\":23,\"attributes\":{\"name\":\"maps\",\"slug\":\"maps\",\"crea